# Cấu hình duy nhất của bản tập. `make up` chép file này thành .env.
# docker compose đọc file này để điền biến (TAG, cổng, mật khẩu DB), và nạp nó vào
# container WAF: tên biến phần dưới là tên setting của BunkerWeb.
# Giống lúc thi, trừ tài khoản: ở đây chỉ có một tài khoản, bạn tự đặt.

# ── Docker ───────────────────────────────────────────────────────────────
# Tag WAF cố định, khớp challenge/waf/VERSION và Compose WAF của challenge.
TAG=1.0.0
# Cổng trên máy bạn (chỉ nghe 127.0.0.1).
BW_PORT=8000
BW_UI_PORT=8005
# Mật khẩu database riêng của BunkerWeb trong máy bạn.
WAF_DB_PASSWORD=ChangeMe_Waf_Db_2026

# ── Tài khoản UI ─────────────────────────────────────────────────────────
# Tài khoản đăng nhập WAF UI duy nhất của bản tập (lúc thi BTC cấp tài khoản đội).
# BunkerWeb tạo và đồng bộ lại tên, mật khẩu mỗi lần khởi động.
# Mật khẩu cần đủ chữ thường, chữ hoa, số, ký tự đặc biệt. Nhận cả hash bcrypt
# (cost >= 13), đặt trong nháy đơn: ADMIN_PASSWORD='$2b$13$...'
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Bw_2026!

# ── Site ─────────────────────────────────────────────────────────────────
SERVER_NAME=localhost
MULTISITE=no
USE_REVERSE_PROXY=yes
REVERSE_PROXY_URL=/
REVERSE_PROXY_HOST=http://fuap_edge:80
SEND_ANONYMOUS_REPORT=no
TZ=Asia/Ho_Chi_Minh

# Mặc định pool 40+20 mỗi tiến trình, quá max_connections=100 của postgres.
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=5

# ── Setting bị KHOÁ trong UI ─────────────────────────────────────────────
# Biến đặt ở đây bị khoá trong UI (method=scheduler), đội không sửa được.
# Biến có giá trị BẰNG mặc định của BunkerWeb thì không được lưu, nên không
# khoá được: chỉ đặt ở đây những giá trị KHÁC mặc định.
# Các tính năng dựa trên IP bị khoá tắt vì lúc thi mọi request đến WAF từ cùng một IP
# reverse proxy của BTC: ban/giới hạn theo IP = chặn luôn bot chấm.
USE_BAD_BEHAVIOR=no
USE_LIMIT_REQ=no
USE_LIMIT_CONN=no
USE_DNSBL=no
# Không có Internet: BunkerNet, danh sách cộng đồng, CRS plugins chỉ treo.
USE_BUNKERNET=no
BLACKLIST_COMMUNITY_LISTS=
USE_MODSECURITY_CRS_PLUGINS=no
# Đội chỉ truy cập qua HTTP, không có chứng chỉ.
AUTO_REDIRECT_HTTP_TO_HTTPS=no
# ModSecurity + CRS mặc định DetectionOnly, blacklist tắt qua seed UI;
# không đặt ở đây để đội vẫn tự chuyển sang chặn được.
